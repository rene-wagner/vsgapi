{% set r = app.request.attributes.get('_route') ?? '' %}
{% set nav_context = nav_context|default('default') %}
{% set base_classes = 'block rounded-lg px-3 py-2 text-sm font-medium transition hover:bg-vsg-blue-800 hover:text-white' %}
{% set active_classes = 'bg-vsg-blue-700 text-white' %}
{% set inactive_classes = 'text-vsg-blue-100' %}
<a href="{{ path('admin_dashboard') }}" class="{{ base_classes }} {{ r == 'admin_dashboard' ? active_classes : inactive_classes }}">Dashboard</a>
<a href="{{ path('admin_user_index') }}" class="{{ base_classes }} {{ r starts with 'admin_user' ? active_classes : inactive_classes }}">Benutzer</a>
<a href="{{ path('admin_category_index') }}" class="{{ base_classes }} {{ r starts with 'admin_category' ? active_classes : inactive_classes }}">Kategorien</a>
<a href="{{ path('admin_post_index') }}" class="{{ base_classes }} {{ r starts with 'admin_post' ? active_classes : inactive_classes }}">Beiträge</a>
<a href="{{ path('admin_location_index') }}" class="{{ base_classes }} {{ r starts with 'admin_location' ? active_classes : inactive_classes }}">Sportstätten</a>
<a href="{{ path('admin_department_index') }}" class="{{ base_classes }} {{ r starts with 'admin_department' ? active_classes : inactive_classes }}">Sportabteilungen</a>
<a href="{{ path('admin_contact_person_index') }}" class="{{ base_classes }} {{ r starts with 'admin_contact_person' ? active_classes : inactive_classes }}">Kontaktpersonen</a>
<a href="{{ path('admin_event_index') }}" class="{{ base_classes }} {{ r starts with 'admin_event' ? active_classes : inactive_classes }}">Veranstaltungen</a>
<a href="{{ path('admin_membership_application_index') }}" class="{{ base_classes }} {{ r starts with 'admin_membership_application' ? active_classes : inactive_classes }}">Anträge</a>
<a href="{{ path('admin_mediathek_index') }}" class="{{ base_classes }} {{ r starts with 'admin_mediathek' or r starts with 'admin_media_folder' ? active_classes : inactive_classes }}">Mediathek</a>
<a href="{{ path('admin_page_content') }}" class="{{ base_classes }} {{ r starts with 'admin_page_content' ? active_classes : inactive_classes }}">Seiteninhalt</a>
