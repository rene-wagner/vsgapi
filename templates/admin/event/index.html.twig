        <h1 class="text-2xl font-semibold text-gray-900">Veranstaltungen</h1>
        <a href="{{ path('admin_event_new') }}" class="inline-flex items-center justify-center rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300">Neue Veranstaltung</a>
