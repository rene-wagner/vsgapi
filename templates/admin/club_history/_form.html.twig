{% form_theme form 'form_div_layout.html.twig' %}

{% macro collection_item(entry, title) %}
    <div class="collection-item rounded-xl border border-gray-200 bg-gray-50 p-5">
        <div class="mb-4 flex items-center justify-between gap-3">
            <h3 class="text-sm font-semibold text-gray-900">{{ title }}</h3>
            <button type="button" class="js-remove-collection-item inline-flex h-10 w-10 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Eintrag entfernen">
                <i class="fa-solid fa-trash" aria-hidden="true"></i>
            </button>
        </div>
        <div class="space-y-4 [&_label]:mb-2 [&_label]:block [&_label]:text-sm [&_label]:font-medium [&_label]:text-gray-900 [&_.form-error-message]:mt-2 [&_.form-error-message]:text-sm [&_.form-error-message]:text-red-600 [&_textarea]:min-h-24">
            {{ form_widget(entry) }}
        </div>
    </div>
{% endmacro %}

{% import _self as macros %}

{% set club_statistics_prototype %}
    <details class="club-statistic-item collection-item overflow-hidden rounded-xl border border-gray-200 bg-gray-50" open>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
            <div class="flex min-w-0 items-start gap-3">
                <div class="mt-0.5 h-10 w-1.5 rounded-full bg-violet-600"></div>
                <div class="min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <h3 class="truncate text-sm font-semibold text-gray-900" data-club-statistic-summary-label>Neue Statistik</h3>
                        <span class="inline-flex items-center rounded-full bg-violet-100 px-2.5 py-1 text-xs font-medium text-violet-800" data-club-statistic-summary-badge>Kein Wert</span>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" class="js-remove-club-statistic inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Statistik entfernen">
                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 transition" data-club-statistic-chevron aria-hidden="true">
                    <i class="fa-solid fa-chevron-down"></i>
                </span>
            </div>
        </summary>
        <div class="border-t border-gray-200 bg-white px-5 py-5">
            <div class="grid gap-4 md:grid-cols-2">
                <div>
                    {{ form_label(form.clubStatistics.vars.prototype.label, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                    {{ form_widget(form.clubStatistics.vars.prototype.label, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                    <div class="mt-2 text-sm text-red-600">{{ form_errors(form.clubStatistics.vars.prototype.label) }}</div>
                </div>
                <div>
                    {{ form_label(form.clubStatistics.vars.prototype.value, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                    {{ form_widget(form.clubStatistics.vars.prototype.value, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                    <div class="mt-2 text-sm text-red-600">{{ form_errors(form.clubStatistics.vars.prototype.value) }}</div>
                </div>
            </div>
        </div>
    </details>
{% endset %}
{% set milestone_prototype %}{{ macros.collection_item(form.milestones.vars.prototype, 'Neuer Meilenstein') }}{% endset %}
{% set hall_of_fame_prototype %}{{ macros.collection_item(form.hallOfFameEntries.vars.prototype, 'Neue Errungenschaft') }}{% endset %}
{% set special_event_prototype %}{{ macros.collection_item(form.specialEvents.vars.prototype, 'Neue Veranstaltung') }}{% endset %}
{% set membership_stat_prototype %}{{ macros.collection_item(form.membershipStats.vars.prototype, 'Neue Statistik') }}{% endset %}

{{ form_start(form, { attr: { class: 'space-y-6', novalidate: 'novalidate' } }) }}
    {{ form_errors(form) }}

    <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-200 px-6 py-4">
            <h2 class="text-sm font-semibold text-gray-900">Stammdaten</h2>
        </div>
        <div class="px-6 py-4">
            <div>
                {{ form_label(form.foundingDate, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                {{ form_widget(form.foundingDate, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                <div class="mt-2 text-sm text-red-600">{{ form_errors(form.foundingDate) }}</div>
            </div>
        </div>
    </section>

    <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-200 px-6 py-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 class="text-sm font-semibold text-gray-900">{{ form.clubStatistics.vars.label }}</h2>
                    <p class="mt-1 text-sm text-gray-500">Pflegen Sie hier die wichtigsten Kennzahlen des Vereins.</p>
                </div>
                <button type="button" class="js-add-club-statistic inline-flex items-center justify-center rounded-lg border border-blue-700 bg-white px-4 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-300"><i class="fa-solid fa-chart-column" aria-hidden="true"></i><span class="ml-2">Statistik hinzufügen</span></button>
            </div>
        </div>
        <div class="px-6 py-4">
            <div class="club-statistics-collection space-y-4" data-prototype="{{ club_statistics_prototype|e('html_attr') }}" data-index="{{ form.clubStatistics|length }}">
                {% for club_statistic in form.clubStatistics %}
                    <details class="club-statistic-item collection-item overflow-hidden rounded-xl border border-gray-200 bg-gray-50">
                        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
                            <div class="flex min-w-0 items-start gap-3">
                                <div class="mt-0.5 h-10 w-1.5 rounded-full bg-violet-600"></div>
                                <div class="min-w-0">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <h3 class="truncate text-sm font-semibold text-gray-900" data-club-statistic-summary-label>{{ club_statistic.label.vars.value ?: 'Neue Statistik' }}</h3>
                                        <span class="inline-flex items-center rounded-full bg-violet-100 px-2.5 py-1 text-xs font-medium text-violet-800" data-club-statistic-summary-badge>{{ club_statistic.value.vars.value ?: 'Kein Wert' }}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button" class="js-remove-club-statistic inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Statistik entfernen">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 transition" data-club-statistic-chevron aria-hidden="true">
                                    <i class="fa-solid fa-chevron-down"></i>
                                </span>
                            </div>
                        </summary>
                        <div class="border-t border-gray-200 bg-white px-5 py-5">
                            <div class="grid gap-4 md:grid-cols-2">
                                <div>
                                    {{ form_label(club_statistic.label, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                    {{ form_widget(club_statistic.label, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                    <div class="mt-2 text-sm text-red-600">{{ form_errors(club_statistic.label) }}</div>
                                </div>
                                <div>
                                    {{ form_label(club_statistic.value, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                    {{ form_widget(club_statistic.value, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                    <div class="mt-2 text-sm text-red-600">{{ form_errors(club_statistic.value) }}</div>
                                </div>
                            </div>
                        </div>
                    </details>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-200 px-6 py-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 class="text-sm font-semibold text-gray-900">{{ form.milestones.vars.label }}</h2>
                </div>
                <button type="button" class="js-add-collection-item inline-flex items-center justify-center rounded-lg border border-blue-700 bg-white px-4 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-300" data-target-collection="milestones"><i class="fa-solid fa-timeline" aria-hidden="true"></i><span class="ml-2">Meilenstein hinzufügen</span></button>
            </div>
        </div>
        <div class="px-6 py-4">
            <div class="space-y-4" data-collection-holder="milestones" data-prototype="{{ milestone_prototype|e('html_attr') }}" data-index="{{ form.milestones|length }}">
                {% for milestone in form.milestones %}
                    {{ macros.collection_item(milestone, 'Meilenstein') }}
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-200 px-6 py-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 class="text-sm font-semibold text-gray-900">{{ form.hallOfFameEntries.vars.label }}</h2>
                </div>
                <button type="button" class="js-add-collection-item inline-flex items-center justify-center rounded-lg border border-blue-700 bg-white px-4 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-300" data-target-collection="hall-of-fame"><i class="fa-solid fa-trophy" aria-hidden="true"></i><span class="ml-2">Errungenschaft hinzufügen</span></button>
            </div>
        </div>
        <div class="px-6 py-4">
            <div class="space-y-4" data-collection-holder="hall-of-fame" data-prototype="{{ hall_of_fame_prototype|e('html_attr') }}" data-index="{{ form.hallOfFameEntries|length }}">
                {% for hall_of_fame_entry in form.hallOfFameEntries %}
                    {{ macros.collection_item(hall_of_fame_entry, 'Errungenschaft') }}
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-200 px-6 py-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 class="text-sm font-semibold text-gray-900">{{ form.specialEvents.vars.label }}</h2>
                </div>
                <button type="button" class="js-add-collection-item inline-flex items-center justify-center rounded-lg border border-blue-700 bg-white px-4 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-300" data-target-collection="special-events"><i class="fa-solid fa-calendar-days" aria-hidden="true"></i><span class="ml-2">Veranstaltung hinzufügen</span></button>
            </div>
        </div>
        <div class="px-6 py-4">
            <div class="space-y-4" data-collection-holder="special-events" data-prototype="{{ special_event_prototype|e('html_attr') }}" data-index="{{ form.specialEvents|length }}">
                {% for special_event in form.specialEvents %}
                    {{ macros.collection_item(special_event, 'Veranstaltung') }}
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-200 px-6 py-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 class="text-sm font-semibold text-gray-900">{{ form.membershipStats.vars.label }}</h2>
                </div>
                <button type="button" class="js-add-collection-item inline-flex items-center justify-center rounded-lg border border-blue-700 bg-white px-4 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-300" data-target-collection="membership-stats"><i class="fa-solid fa-users" aria-hidden="true"></i><span class="ml-2">Statistik hinzufügen</span></button>
            </div>
        </div>
        <div class="px-6 py-4">
            <div class="space-y-4" data-collection-holder="membership-stats" data-prototype="{{ membership_stat_prototype|e('html_attr') }}" data-index="{{ form.membershipStats|length }}">
                {% for membership_stat in form.membershipStats %}
                    {{ macros.collection_item(membership_stat, 'Mitgliederstatistik') }}
                {% endfor %}
            </div>
        </div>
    </section>

    <div class="flex items-center gap-3">
        <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300">Speichern</button>
    </div>
{{ form_end(form) }}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        function updateClubStatisticSummary(item) {
            var labelInput = item.querySelector('input[name$="[label]"]');
            var valueInput = item.querySelector('input[name$="[value]"]');
            var summaryLabel = item.querySelector('[data-club-statistic-summary-label]');
            var summaryBadge = item.querySelector('[data-club-statistic-summary-badge]');

            if (summaryLabel) {
                summaryLabel.textContent = labelInput && labelInput.value.trim() !== '' ? labelInput.value.trim() : 'Neue Statistik';
            }

            if (summaryBadge) {
                summaryBadge.textContent = valueInput && valueInput.value.trim() !== '' ? valueInput.value.trim() : 'Kein Wert';
            }
        }

        function updateClubStatisticChevron(item) {
            var chevron = item.querySelector('[data-club-statistic-chevron] i');

            if (!chevron) {
                return;
            }

            chevron.classList.toggle('fa-chevron-down', !item.open);
            chevron.classList.toggle('fa-chevron-up', item.open);
        }

        function bindClubStatisticSummaryInputs(item) {
            var labelInput = item.querySelector('input[name$="[label]"]');
            var valueInput = item.querySelector('input[name$="[value]"]');

            [labelInput, valueInput].forEach(function (input) {
                if (!input) {
                    return;
                }

                input.addEventListener('input', function () {
                    updateClubStatisticSummary(item);
                });
            });
        }

        document.querySelectorAll('.club-statistic-item').forEach(function (item) {
            bindClubStatisticSummaryInputs(item);
            updateClubStatisticSummary(item);
            updateClubStatisticChevron(item);
            item.addEventListener('toggle', function () {
                updateClubStatisticChevron(item);
            });
        });

        document.querySelectorAll('.js-add-club-statistic').forEach(function (button) {
            button.addEventListener('click', function () {
                var holder = document.querySelector('.club-statistics-collection');

                if (!holder) {
                    return;
                }

                var prototype = holder.dataset.prototype;
                var index = parseInt(holder.dataset.index || '0', 10);
                var item = prototype.replace(/__name__/g, index);

                holder.dataset.index = String(index + 1);
                holder.insertAdjacentHTML('beforeend', item);

                var addedItem = holder.lastElementChild;
                if (!addedItem) {
                    return;
                }

                bindClubStatisticSummaryInputs(addedItem);
                updateClubStatisticSummary(addedItem);
                updateClubStatisticChevron(addedItem);
                addedItem.addEventListener('toggle', function () {
                    updateClubStatisticChevron(addedItem);
                });
            });
        });

        document.querySelectorAll('.js-add-collection-item').forEach(function (button) {
            button.addEventListener('click', function () {
                var target = button.dataset.targetCollection;
                var holder = document.querySelector('[data-collection-holder="' + target + '"]');

                if (!holder) {
                    return;
                }

                var prototype = holder.dataset.prototype;
                var index = parseInt(holder.dataset.index || '0', 10);
                var item = prototype.replace(/__name__/g, index);

                holder.dataset.index = String(index + 1);
                holder.insertAdjacentHTML('beforeend', item);
            });
        });

        document.addEventListener('click', function (event) {
            var removeButton = event.target.closest('.js-remove-collection-item, .js-remove-club-statistic');

            if (!removeButton) {
                return;
            }

            var item = removeButton.closest('.collection-item');
            if (item) {
                item.remove();
            }
        });
    });
</script>
