{% form_theme form 'form_div_layout.html.twig' %}

{{ form_start(form, { attr: { class: 'department-form space-y-6', novalidate: 'novalidate' } }) }}
    {{ form_errors(form) }}

    <div class="grid gap-6 lg:grid-cols-2">
        <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
            <div class="border-b border-gray-200 px-6 py-4">
                <h2 class="text-sm font-semibold text-gray-900">Stammdaten</h2>
            </div>
            <div class="space-y-4 px-6 py-4">
                <div>
                    {{ form_label(form.name, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                    {{ form_widget(form.name, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                    <div class="mt-2 text-sm text-red-600">{{ form_errors(form.name) }}</div>
                </div>

                <div>
                    {{ form_label(form.color, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                    {{ form_widget(form.color, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                    <div class="mt-2 text-sm text-red-600">{{ form_errors(form.color) }}</div>
                </div>

                <div>
                    {{ form_label(form.manager, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                    {{ form_widget(form.manager, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                    <div class="mt-2 text-sm text-red-600">{{ form_errors(form.manager) }}</div>
                </div>
            </div>
        </section>

        <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
            <div class="border-b border-gray-200 px-6 py-4">
                <h2 class="text-sm font-semibold text-gray-900">Beschreibung</h2>
            </div>
            <div class="px-6 py-4">
                {{ form_label(form.description, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                {{ form_widget(form.description, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500', 'data-controller': 'easymde', rows: 10 } }) }}
                <div class="mt-2 text-sm text-red-600">{{ form_errors(form.description) }}</div>
            </div>
        </section>
    </div>

    <div class="space-y-6">
        <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
            <div class="border-b border-gray-200 px-6 py-4">
                <h2 class="text-sm font-semibold text-gray-900">{{ form.icon.vars.label }}</h2>
            </div>
            <div class="px-6 py-4">
                {% if department.icon %}
                    <div data-media-selector>
                        {{ include('admin/_media_item_card.html.twig', {
                            media_item: department.icon,
                            media_url: media_url,
                            title: 'Aktuelles Icon'|trans,
                            selector_content: '
                                <div class="space-y-3">
                                    <p class="text-sm font-medium text-gray-900">' ~ 'Icon auswählen'|trans ~ '</p>
                                    <div class="flex flex-wrap gap-2">
                                        <button type="button" class="inline-flex items-center rounded-lg border border-blue-700 px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-300" data-media-selector-open>
                                            <i class="fa-solid fa-image" aria-hidden="true"></i><span class="ml-2">' ~ 'Auswählen'|trans ~ '</span>
                                        </button>
                                        <button type="button" class="inline-flex items-center rounded-lg border border-red-700 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus:ring-4 focus:ring-red-300" data-media-selector-remove >
                                            <i class="fa-solid fa-trash" aria-hidden="true"></i><span class="ml-2">' ~ 'Entfernen'|trans ~ '</span>
                                        </button>
                                    </div>
                                </div>
                            '
                        }) }}
                        {{ form_widget(form.icon) }}
                    </div>
                {% else %}
                    <div data-media-selector>
                        <div data-media-selector-preview class="admin-media-selector-preview"></div>
                        {{ form_widget(form.icon) }}
                        <div class="mt-3 flex flex-wrap gap-2">
                            <button type="button" class="inline-flex items-center rounded-lg border border-blue-700 px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-300" data-media-selector-open>
                                <i class="fa-solid fa-image" aria-hidden="true"></i><span class="ml-2">{{ 'Auswählen'|trans }}</span>
                            </button>
                            <button type="button" class="inline-flex items-center rounded-lg border border-red-700 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus:ring-4 focus:ring-red-300" data-media-selector-remove  disabled>
                                <i class="fa-solid fa-trash" aria-hidden="true"></i><span class="ml-2">{{ 'Entfernen'|trans }}</span>
                            </button>
                        </div>
                    </div>
                {% endif %}
            </div>
        </section>

        <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
            <div class="border-b border-gray-200 px-6 py-4">
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                    <div>
                        <h2 class="text-sm font-semibold text-gray-900">{{ form.departmentStats.vars.label }}</h2>
                        <p class="mt-1 text-sm text-gray-500">Pflegen Sie hier die wichtigsten Kennzahlen der Abteilung.</p>
                    </div>
                    <button type="button" class="js-add-stat inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Statistik hinzufügen</button>
                </div>
            </div>
            <div class="px-6 py-4">
                <div class="collection-holder department-stats-collection space-y-4" data-prototype="{{ form_widget(form.departmentStats.vars.prototype)|e('html_attr') }}" data-index="{{ form.departmentStats|length }}">
                {% for stat in form.departmentStats %}
                    <details class="department-stat-item collection-item overflow-hidden rounded-xl border border-gray-200 bg-gray-50"{% if loop.first %} open{% endif %}>
                        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
                            <div class="flex min-w-0 items-start gap-3">
                                <div class="mt-0.5 h-10 w-1.5 rounded-full bg-violet-600"></div>
                                <div class="min-w-0">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <h3 class="truncate text-sm font-semibold text-gray-900" data-stat-summary-label>{{ stat.label.vars.value ?: 'Neue Statistik' }}</h3>
                                        <span class="inline-flex items-center rounded-full bg-violet-100 px-2.5 py-1 text-xs font-medium text-violet-800" data-stat-summary-badge>{{ stat.value.vars.value ?: 'Kein Wert' }}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button" class="js-remove-stat inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Statistik entfernen">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 transition" data-stat-chevron aria-hidden="true">
                                    <i class="fa-solid fa-chevron-down"></i>
                                </span>
                            </div>
                        </summary>
                        <div class="border-t border-gray-200 bg-white px-5 py-5">
                            <div class="grid gap-4 md:grid-cols-2">
                                <div>
                                    {{ form_label(stat.label, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                    {{ form_widget(stat.label, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                    <div class="mt-2 text-sm text-red-600">{{ form_errors(stat.label) }}</div>
                                </div>
                                <div>
                                    {{ form_label(stat.value, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                    {{ form_widget(stat.value, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                    <div class="mt-2 text-sm text-red-600">{{ form_errors(stat.value) }}</div>
                                </div>
                            </div>
                        </div>
                    </details>
                {% endfor %}
            </div>
            </div>
        </section>
    </div>

    <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-200 px-6 py-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 class="text-sm font-semibold text-gray-900">{{ form.trainingGroups.vars.label }}</h2>
                    <p class="mt-1 text-sm text-gray-500">Jede Trainingsgruppe enthält ihre Stammdaten und eine Liste der Trainingseinheiten.</p>
                </div>
                <button type="button" class="js-add-group inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Trainingsgruppe hinzufügen</button>
            </div>
        </div>
        <div class="px-6 py-4">
            <div class="collection-holder department-training-groups-collection space-y-4" data-prototype="{{ form_widget(form.trainingGroups.vars.prototype)|e('html_attr') }}" data-index="{{ form.trainingGroups|length }}">
                {% for group in form.trainingGroups %}
                    <details class="training-group-item collection-item overflow-hidden rounded-xl border border-gray-200 bg-gray-50"{% if loop.first %} open{% endif %}>
                        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
                            <div class="flex min-w-0 items-start gap-3">
                                <div class="mt-0.5 h-10 w-1.5 rounded-full bg-blue-600"></div>
                                <div class="min-w-0">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <h3 class="truncate text-sm font-semibold text-gray-900" data-group-summary-name>{{ group.name.vars.value ?: 'Neue Trainingsgruppe' }}</h3>
                                        <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-1 text-xs font-medium text-blue-800" data-group-summary-badge>{{ group.departmentTrainingSessions|length }} Trainingseinheit{% if group.departmentTrainingSessions|length != 1 %}en{% endif %}</span>
                                    </div>
                                    <p class="mt-1 text-sm text-gray-500" data-group-summary-meta>
                                        {{ group.ageRange.vars.value ?: 'Keine Altersgruppe' }}
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button" class="js-remove-group inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Trainingsgruppe entfernen">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 transition" data-group-chevron aria-hidden="true">
                                    <i class="fa-solid fa-chevron-down"></i>
                                </span>
                            </div>
                        </summary>
                        <div class="border-t border-gray-200 bg-white px-5 py-5">
                            <div class="grid gap-4 md:grid-cols-2">
                                <div>
                                    {{ form_label(group.name, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                    {{ form_widget(group.name, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                    {% if group.name.vars.help %}<p class="mt-2 text-sm text-gray-500">{{ group.name.vars.help }}</p>{% endif %}
                                    <div class="mt-2 text-sm text-red-600">{{ form_errors(group.name) }}</div>
                                </div>
                                <div>
                                    {{ form_label(group.ageRange, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                    {{ form_widget(group.ageRange, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                    {% if group.ageRange.vars.help %}<p class="mt-2 text-sm text-gray-500">{{ group.ageRange.vars.help }}</p>{% endif %}
                                    <div class="mt-2 text-sm text-red-600">{{ form_errors(group.ageRange) }}</div>
                                </div>
                            </div>

                            <div class="mt-8 pt-6 training-group-sessions">
                                <div class="mb-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                                    <div>
                                        <h4 class="text-sm font-semibold text-gray-900">{{ group.departmentTrainingSessions.vars.label }}</h4>
                                        <div class="mt-1 text-sm text-red-600">{{ form_errors(group.departmentTrainingSessions) }}</div>
                                    </div>
                                    <button type="button" class="js-add-session inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Trainingseinheit hinzufügen</button>
                                </div>

                                <p class="js-empty-sessions text-sm text-gray-500{% if group.departmentTrainingSessions|length > 0 %} hidden{% endif %}">Noch keine Trainingseinheiten vorhanden.</p>

                                <div class="collection-holder department-training-sessions-collection divide-y divide-gray-200" data-prototype="{{ form_widget(group.departmentTrainingSessions.vars.prototype)|e('html_attr') }}" data-index="{{ group.departmentTrainingSessions|length }}">
                                    {% for session in group.departmentTrainingSessions %}
                                        <div class="collection-item py-4 first:pt-0 last:pb-0">
                                            <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)_auto] md:items-start">
                                                <div>
                                                    {{ form_label(session.day, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                                    {{ form_widget(session.day, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                                    {% if session.day.vars.help %}<p class="mt-2 text-sm text-gray-500">{{ session.day.vars.help }}</p>{% endif %}
                                                    <div class="mt-2 text-sm text-red-600">{{ form_errors(session.day) }}</div>
                                                </div>
                                                <div>
                                                    {{ form_label(session.time, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                                    {{ form_widget(session.time, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                                    {% if session.time.vars.help %}<p class="mt-2 text-sm text-gray-500">{{ session.time.vars.help }}</p>{% endif %}
                                                    <div class="mt-2 text-sm text-red-600">{{ form_errors(session.time) }}</div>
                                                </div>
                                                <div>
                                                    {{ form_label(session.location, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                                    {{ form_widget(session.location, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                                    <div class="mt-2 text-sm text-red-600">{{ form_errors(session.location) }}</div>
                                                </div>
                                                <div class="md:pt-8">
                                                    <button type="button" class="js-remove-session inline-flex h-10 w-10 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Trainingseinheit entfernen">
                                                        <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </details>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-200 px-6 py-4">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 class="text-sm font-semibold text-gray-900">{{ form.departmentResults.vars.label }}</h2>
                    <p class="mt-1 text-sm text-gray-500">Pflegen Sie hier die externen Ergebnisdienst-Einträge der Abteilung.</p>
                </div>
                <button type="button" class="js-add-result inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Ergebnisdienst hinzufügen</button>
            </div>
        </div>
        <div class="px-6 py-4">
            <div class="collection-holder department-results-collection space-y-4" data-prototype="{{ form_widget(form.departmentResults.vars.prototype)|e('html_attr') }}" data-index="{{ form.departmentResults|length }}">
                {% for result in form.departmentResults %}
                    <details class="department-result-item collection-item overflow-hidden rounded-xl border border-gray-200 bg-gray-50"{% if loop.first %} open{% endif %}>
                        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 bg-gradient-to-r from-slate-50 to-white px-5 py-4">
                            <div class="flex min-w-0 items-start gap-3">
                                <div class="mt-0.5 h-10 w-1.5 rounded-full bg-emerald-600"></div>
                                <div class="min-w-0">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <h3 class="truncate text-sm font-semibold text-gray-900" data-result-summary-title>{{ result.title.vars.value ?: 'Neuer Ergebnisdienst' }}</h3>
                                        <span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-medium text-emerald-800" data-result-summary-badge>{{ result.league.vars.value ?: 'Keine Liga' }}</span>
                                    </div>
                                    <p class="mt-1 text-sm text-gray-500" data-result-summary-url>
                                        {% if result.url.vars.value %}{{ result.url.vars.value }}{% else %}Keine URL hinterlegt{% endif %}
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button" class="js-remove-result inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Ergebnisdienst entfernen">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                                <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 transition" data-result-chevron aria-hidden="true">
                                    <i class="fa-solid fa-chevron-down"></i>
                                </span>
                            </div>
                        </summary>
                        <div class="border-t border-gray-200 bg-white px-5 py-5">
                            <div class="grid gap-4 md:grid-cols-3">
                                <div>
                                    {{ form_label(result.title, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                    {{ form_widget(result.title, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                    <div class="mt-2 text-sm text-red-600">{{ form_errors(result.title) }}</div>
                                </div>
                                <div>
                                    {{ form_label(result.league, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                    {{ form_widget(result.league, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                    <div class="mt-2 text-sm text-red-600">{{ form_errors(result.league) }}</div>
                                </div>
                                <div>
                                    {{ form_label(result.url, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                    {{ form_widget(result.url, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                    <div class="mt-2 text-sm text-red-600">{{ form_errors(result.url) }}</div>
                                </div>
                            </div>
                        </div>
                    </details>
                {% endfor %}
            </div>
        </div>
    </section>

    <div class="flex items-center gap-3">
        <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300">Speichern</button>
        <a href="{{ path('admin_department_index') }}" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Abbrechen</a>
    </div>
{{ form_end(form) }}

<script>
(function () {
    var fieldClass = 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500';
    var labelClass = 'mb-2 block text-sm font-medium text-gray-900';
    var helpClass = 'mt-2 text-sm text-gray-500';

    function applyFieldClasses(root) {
        root.querySelectorAll('input, select, textarea').forEach(function (field) {
            if (field.type === 'hidden') {
                return;
            }
            field.className = fieldClass;
        });

        root.querySelectorAll('label').forEach(function (label) {
            label.className = labelClass;
        });

        root.querySelectorAll('small, .form-text').forEach(function (help) {
            help.className = helpClass;
        });
    }

    function bindRemove(btn) {
        btn.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();

            var item = btn.closest('.collection-item');
            var sessionsHolder = btn.closest('.department-training-sessions-collection');
            var groupItem = btn.closest('.training-group-item');
            var resultItem = btn.closest('.department-result-item');

            if (!item) {
                return;
            }

            item.remove();

            if (sessionsHolder) {
                updateSessionsState(sessionsHolder);
            }

            if (groupItem) {
                updateGroupSummary(groupItem);
            }

            if (resultItem) {
                updateResultSummary(resultItem);
            }
        });
    }

    function removeCardButtonHtml(jsClass, ariaLabel) {
        return '<button type="button" class="' + jsClass + ' absolute right-3 top-3 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="' + ariaLabel + '"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>';
    }

    function sessionRemoveButtonHtml() {
        return '<button type="button" class="js-remove-session inline-flex h-10 w-10 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Trainingseinheit entfernen"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>';
    }

    function textRemoveButtonHtml(label, ariaLabel) {
        return '<div class="mt-3"><button type="button" class="js-remove-collection-item text-sm font-medium text-red-600 hover:underline" aria-label="' + ariaLabel + '">' + label + '</button></div>';
    }

    function getCollectionItemCount(holder) {
        return Array.prototype.filter.call(holder.children, function (child) {
            return child.classList.contains('collection-item');
        }).length;
    }

    function updateGroupSummary(groupItem) {
        var nameInput = groupItem.querySelector('input[name$="[name]"]');
        var ageRangeInput = groupItem.querySelector('input[name$="[ageRange]"]');
        var summaryName = groupItem.querySelector('[data-group-summary-name]');
        var summaryMeta = groupItem.querySelector('[data-group-summary-meta]');
        var summaryBadge = groupItem.querySelector('[data-group-summary-badge]');
        var sessionsHolder = groupItem.querySelector('.department-training-sessions-collection');
        var sessionCount = sessionsHolder ? getCollectionItemCount(sessionsHolder) : 0;
        var sessionLabel = sessionCount === 1 ? 'Trainingseinheit' : 'Trainingseinheiten';

        if (summaryName) {
            summaryName.textContent = nameInput && nameInput.value.trim() !== '' ? nameInput.value.trim() : 'Neue Trainingsgruppe';
        }

        if (summaryMeta) {
            var ageRangeText = ageRangeInput && ageRangeInput.value.trim() !== '' ? ageRangeInput.value.trim() : 'Keine Altersgruppe';
            summaryMeta.textContent = ageRangeText;
        }

        if (summaryBadge) {
            summaryBadge.textContent = sessionCount + ' ' + sessionLabel;
        }
    }

    function updateGroupChevron(groupItem) {
        var chevron = groupItem.querySelector('[data-group-chevron]');

        if (chevron) {
            chevron.style.transform = groupItem.open ? 'rotate(180deg)' : 'rotate(0deg)';
        }
    }

    function updateStatSummary(statItem) {
        var labelInput = statItem.querySelector('input[name$="[label]"]');
        var valueInput = statItem.querySelector('input[name$="[value]"]');
        var summaryLabel = statItem.querySelector('[data-stat-summary-label]');
        var summaryBadge = statItem.querySelector('[data-stat-summary-badge]');

        if (summaryLabel) {
            summaryLabel.textContent = labelInput && labelInput.value.trim() !== '' ? labelInput.value.trim() : 'Neue Statistik';
        }

        if (summaryBadge) {
            summaryBadge.textContent = valueInput && valueInput.value.trim() !== '' ? valueInput.value.trim() : 'Kein Wert';
        }
    }

    function updateStatChevron(statItem) {
        var chevron = statItem.querySelector('[data-stat-chevron]');

        if (chevron) {
            chevron.style.transform = statItem.open ? 'rotate(180deg)' : 'rotate(0deg)';
        }
    }

    function updateResultSummary(resultItem) {
        var titleInput = resultItem.querySelector('input[name$="[title]"]');
        var leagueInput = resultItem.querySelector('input[name$="[league]"]');
        var urlInput = resultItem.querySelector('input[name$="[url]"]');
        var summaryTitle = resultItem.querySelector('[data-result-summary-title]');
        var summaryBadge = resultItem.querySelector('[data-result-summary-badge]');
        var summaryUrl = resultItem.querySelector('[data-result-summary-url]');

        if (summaryTitle) {
            summaryTitle.textContent = titleInput && titleInput.value.trim() !== '' ? titleInput.value.trim() : 'Neuer Ergebnisdienst';
        }

        if (summaryBadge) {
            summaryBadge.textContent = leagueInput && leagueInput.value.trim() !== '' ? leagueInput.value.trim() : 'Keine Liga';
        }

        if (summaryUrl) {
            summaryUrl.textContent = urlInput && urlInput.value.trim() !== '' ? urlInput.value.trim() : 'Keine URL hinterlegt';
        }
    }

    function updateResultChevron(resultItem) {
        var chevron = resultItem.querySelector('[data-result-chevron]');

        if (chevron) {
            chevron.style.transform = resultItem.open ? 'rotate(180deg)' : 'rotate(0deg)';
        }
    }

    function updateSessionsState(holder) {
        var groupItem = holder.closest('.training-group-item');
        var emptyState = holder.parentElement.querySelector('.js-empty-sessions');
        var hasItems = getCollectionItemCount(holder) > 0;

        if (emptyState) {
            emptyState.classList.toggle('hidden', hasItems);
        }

        if (groupItem) {
            updateGroupSummary(groupItem);
        }
    }

    function bindGroupSummaryInputs(groupItem) {
        var nameInput = groupItem.querySelector('input[name$="[name]"]');
        var ageRangeInput = groupItem.querySelector('input[name$="[ageRange]"]');

        [nameInput, ageRangeInput].forEach(function (input) {
            if (!input) {
                return;
            }

            input.addEventListener('input', function () {
                updateGroupSummary(groupItem);
            });
        });
    }

    function bindResultSummaryInputs(resultItem) {
        var titleInput = resultItem.querySelector('input[name$="[title]"]');
        var leagueInput = resultItem.querySelector('input[name$="[league]"]');
        var urlInput = resultItem.querySelector('input[name$="[url]"]');

        [titleInput, leagueInput, urlInput].forEach(function (input) {
            if (!input) {
                return;
            }

            input.addEventListener('input', function () {
                updateResultSummary(resultItem);
            });
        });
    }

    function bindStatSummaryInputs(statItem) {
        var labelInput = statItem.querySelector('input[name$="[label]"]');
        var valueInput = statItem.querySelector('input[name$="[value]"]');

        [labelInput, valueInput].forEach(function (input) {
            if (!input) {
                return;
            }

            input.addEventListener('input', function () {
                updateStatSummary(statItem);
            });
        });
    }

    function createSessionRow(sessionHtml) {
        var temp = document.createElement('div');
        temp.innerHTML = sessionHtml;

        var dayInput = temp.querySelector('input[name$="[day]"]');
        var timeInput = temp.querySelector('input[name$="[time]"]');
        var locationInput = temp.querySelector('select[name$="[location]"]');

        var row = document.createElement('div');
        row.className = 'collection-item py-4 first:pt-0 last:pb-0';
        row.innerHTML =
            '<div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)_auto] md:items-start">' +
                '<div><label>Tag</label>' + (dayInput ? dayInput.outerHTML : '') + '<p class="mt-2 text-sm text-gray-500">z. B. Montag oder Mo</p></div>' +
                '<div><label>Zeit</label>' + (timeInput ? timeInput.outerHTML : '') + '<p class="mt-2 text-sm text-gray-500">z. B. 17:00 – 22:00 Uhr</p></div>' +
                '<div><label>Sportstätte</label>' + (locationInput ? locationInput.outerHTML : '') + '</div>' +
                '<div class="md:pt-8">' + sessionRemoveButtonHtml() + '</div>' +
            '</div>';

        return row;
    }

    function bindAddSession(btn) {
        btn.addEventListener('click', function () {
            var groupItem = btn.closest('.training-group-item');
            var holder = groupItem.querySelector('.department-training-sessions-collection');
            var proto = holder.dataset.prototype;
            var sidx = parseInt(holder.dataset.index, 10);
            var row = createSessionRow(proto.replace(/__session__/g, String(sidx)));

            holder.appendChild(row);
            holder.dataset.index = String(sidx + 1);
            applyFieldClasses(row);
            bindRemove(row.querySelector('.js-remove-session'));
            updateSessionsState(holder);
        });
    }

    function createStatItem(statHtml) {
        var temp = document.createElement('div');
        temp.innerHTML = statHtml;

        var labelInput = temp.querySelector('input[name$="[label]"]');
        var valueInput = temp.querySelector('input[name$="[value]"]');

        var item = document.createElement('details');
        item.className = 'department-stat-item collection-item overflow-hidden rounded-xl border border-gray-200 bg-gray-50';
        item.open = true;
        item.innerHTML =
            '<summary class="flex cursor-pointer list-none items-start justify-between gap-4 bg-gradient-to-r from-slate-50 to-white px-5 py-4">' +
                '<div class="flex min-w-0 items-start gap-3">' +
                    '<div class="mt-0.5 h-10 w-1.5 rounded-full bg-violet-600"></div>' +
                    '<div class="min-w-0">' +
                        '<div class="flex flex-wrap items-center gap-2">' +
                            '<h3 class="truncate text-sm font-semibold text-gray-900" data-stat-summary-label>Neue Statistik</h3>' +
                            '<span class="inline-flex items-center rounded-full bg-violet-100 px-2.5 py-1 text-xs font-medium text-violet-800" data-stat-summary-badge>Kein Wert</span>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
                '<div class="flex items-center gap-2">' +
                    '<button type="button" class="js-remove-stat inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Statistik entfernen"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>' +
                    '<span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 transition" data-stat-chevron aria-hidden="true"><i class="fa-solid fa-chevron-down"></i></span>' +
                '</div>' +
            '</summary>' +
            '<div class="border-t border-gray-200 bg-white px-5 py-5">' +
                '<div class="grid gap-4 md:grid-cols-2">' +
                    '<div><label>Bezeichnung</label>' + (labelInput ? labelInput.outerHTML : '') + '</div>' +
                    '<div><label>Wert</label>' + (valueInput ? valueInput.outerHTML : '') + '</div>' +
                '</div>' +
            '</div>';

        return item;
    }

    document.querySelectorAll('.js-add-stat').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var holder = document.querySelector('.department-stats-collection');
            var proto = holder.dataset.prototype;
            var idx = parseInt(holder.dataset.index, 10);
            var item = createStatItem(proto.replace(/__stat__/g, String(idx)));

            holder.appendChild(item);
            holder.dataset.index = String(idx + 1);
            applyFieldClasses(item);
            bindRemove(item.querySelector('.js-remove-stat'));
            bindStatSummaryInputs(item);
            item.addEventListener('toggle', function () {
                updateStatChevron(item);
            });
            updateStatSummary(item);
            updateStatChevron(item);
        });
    });

    function createResultItem(resultHtml) {
        var temp = document.createElement('div');
        temp.innerHTML = resultHtml;

        var titleInput = temp.querySelector('input[name$="[title]"]');
        var leagueInput = temp.querySelector('input[name$="[league]"]');
        var urlInput = temp.querySelector('input[name$="[url]"]');

        var item = document.createElement('details');
        item.className = 'department-result-item collection-item overflow-hidden rounded-xl border border-gray-200 bg-gray-50';
        item.open = true;
        item.innerHTML =
            '<summary class="flex cursor-pointer list-none items-start justify-between gap-4 bg-gradient-to-r from-slate-50 to-white px-5 py-4">' +
                '<div class="flex min-w-0 items-start gap-3">' +
                    '<div class="mt-0.5 h-10 w-1.5 rounded-full bg-emerald-600"></div>' +
                    '<div class="min-w-0">' +
                        '<div class="flex flex-wrap items-center gap-2">' +
                            '<h3 class="truncate text-sm font-semibold text-gray-900" data-result-summary-title>Neuer Ergebnisdienst</h3>' +
                            '<span class="inline-flex items-center rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-medium text-emerald-800" data-result-summary-badge>Keine Liga</span>' +
                        '</div>' +
                        '<p class="mt-1 text-sm text-gray-500" data-result-summary-url>Keine URL hinterlegt</p>' +
                    '</div>' +
                '</div>' +
                '<div class="flex items-center gap-2">' +
                    '<button type="button" class="js-remove-result inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Ergebnisdienst entfernen"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>' +
                    '<span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 transition" data-result-chevron aria-hidden="true"><i class="fa-solid fa-chevron-down"></i></span>' +
                '</div>' +
            '</summary>' +
            '<div class="border-t border-gray-200 bg-white px-5 py-5">' +
                '<div class="grid gap-4 md:grid-cols-3">' +
                    '<div><label>Titel</label>' + (titleInput ? titleInput.outerHTML : '') + '</div>' +
                    '<div><label>Liga</label>' + (leagueInput ? leagueInput.outerHTML : '') + '</div>' +
                    '<div><label>URL</label>' + (urlInput ? urlInput.outerHTML : '') + '</div>' +
                '</div>' +
            '</div>';

        return item;
    }

    document.querySelectorAll('.js-add-result').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var holder = document.querySelector('.department-results-collection');
            var proto = holder.dataset.prototype;
            var idx = parseInt(holder.dataset.index, 10);
            var item = createResultItem(proto.replace(/__result__/g, String(idx)));

            holder.appendChild(item);
            holder.dataset.index = String(idx + 1);
            applyFieldClasses(item);
            bindRemove(item.querySelector('.js-remove-result'));
            bindResultSummaryInputs(item);
            item.addEventListener('toggle', function () {
                updateResultChevron(item);
            });
            updateResultSummary(item);
            updateResultChevron(item);
        });
    });

    function createTrainingGroupItem(groupHtml) {
        var temp = document.createElement('div');
        temp.innerHTML = groupHtml;

        var nameInput = temp.querySelector('input[name$="[name]"]');
        var ageRangeInput = temp.querySelector('input[name$="[ageRange]"]');
        var sessionsHolder = temp.querySelector('.department-training-sessions-collection');

        var item = document.createElement('details');
        item.className = 'training-group-item collection-item overflow-hidden rounded-xl border border-gray-200 bg-gray-50';
        item.open = true;
        item.innerHTML =
            '<summary class="flex cursor-pointer list-none items-start justify-between gap-4 bg-gradient-to-r from-slate-50 to-white px-5 py-4">' +
                '<div class="flex min-w-0 items-start gap-3">' +
                    '<div class="mt-0.5 h-10 w-1.5 rounded-full bg-blue-600"></div>' +
                    '<div class="min-w-0">' +
                        '<div class="flex flex-wrap items-center gap-2">' +
                            '<h3 class="truncate text-sm font-semibold text-gray-900" data-group-summary-name>Neue Trainingsgruppe</h3>' +
                            '<span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-1 text-xs font-medium text-blue-800" data-group-summary-badge>0 Trainingseinheiten</span>' +
                        '</div>' +
                        '<p class="mt-1 text-sm text-gray-500" data-group-summary-meta>Keine Altersgruppe</p>' +
                    '</div>' +
                '</div>' +
                '<div class="flex items-center gap-2">' +
                    '<button type="button" class="js-remove-group inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Trainingsgruppe entfernen"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>' +
                    '<span class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 transition" data-group-chevron aria-hidden="true"><i class="fa-solid fa-chevron-down"></i></span>' +
                '</div>' +
            '</summary>' +
            '<div class="border-t border-gray-200 bg-white px-5 py-5">' +
                '<div class="grid gap-4 md:grid-cols-2">' +
                    '<div><label>Name der Gruppe</label>' + (nameInput ? nameInput.outerHTML : '') + '<p class="mt-2 text-sm text-gray-500">z. B. Jugend oder Erwachsene</p></div>' +
                    '<div><label>Altersgruppe</label>' + (ageRangeInput ? ageRangeInput.outerHTML : '') + '<p class="mt-2 text-sm text-gray-500">Optional, z. B. 6 – 17 oder Erwachsene</p></div>' +
                '</div>' +
                '<div class="mt-8 pt-6 training-group-sessions">' +
                    '<div class="mb-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">' +
                        '<div><h4 class="text-sm font-semibold text-gray-900">Trainingseinheiten</h4><div class="mt-1 text-sm text-red-600"></div></div>' +
                        '<button type="button" class="js-add-session inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Trainingseinheit hinzufügen</button>' +
                    '</div>' +
                    '<p class="js-empty-sessions text-sm text-gray-500">Noch keine Trainingseinheiten vorhanden.</p>' +
                    '<div class="collection-holder department-training-sessions-collection divide-y divide-gray-200" data-prototype="' + (sessionsHolder ? sessionsHolder.dataset.prototype : '') + '" data-index="0"></div>' +
                '</div>' +
            '</div>';

        return item;
    }

    document.querySelectorAll('.js-add-group').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var holder = document.querySelector('.department-training-groups-collection');
            var proto = holder.dataset.prototype;
            var idx = parseInt(holder.dataset.index, 10);
            var item = createTrainingGroupItem(proto.replace(/__session__/g, '0').replace(/__group__/g, String(idx)));

            holder.appendChild(item);
            holder.dataset.index = String(idx + 1);
            applyFieldClasses(item);
            bindAddSession(item.querySelector('.js-add-session'));
            bindRemove(item.querySelector('.js-remove-group'));
            bindGroupSummaryInputs(item);
            item.addEventListener('toggle', function () {
                updateGroupChevron(item);
            });
            updateSessionsState(item.querySelector('.department-training-sessions-collection'));
            updateGroupSummary(item);
            updateGroupChevron(item);
        });
    });

    document.querySelectorAll('.training-group-item').forEach(function (item) {
        bindAddSession(item.querySelector('.js-add-session'));
        bindRemove(item.querySelector('.js-remove-group'));
        bindGroupSummaryInputs(item);
        item.querySelectorAll('.js-remove-session').forEach(bindRemove);
        item.addEventListener('toggle', function () {
            updateGroupChevron(item);
        });
        updateSessionsState(item.querySelector('.department-training-sessions-collection'));
        updateGroupSummary(item);
        updateGroupChevron(item);
    });

    document.querySelectorAll('.department-result-item').forEach(function (item) {
        bindRemove(item.querySelector('.js-remove-result'));
        bindResultSummaryInputs(item);
        item.addEventListener('toggle', function () {
            updateResultChevron(item);
        });
        updateResultSummary(item);
        updateResultChevron(item);
    });

    document.querySelectorAll('.department-stat-item').forEach(function (item) {
        bindRemove(item.querySelector('.js-remove-stat'));
        bindStatSummaryInputs(item);
        item.addEventListener('toggle', function () {
            updateStatChevron(item);
        });
        updateStatSummary(item);
        updateStatChevron(item);
    });

    applyFieldClasses(document.querySelector('.department-form'));
})();
</script>
