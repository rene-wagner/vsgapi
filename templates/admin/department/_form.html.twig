{% form_theme form 'form_div_layout.html.twig' %}

{{ form_start(form, { attr: { class: 'department-form space-y-6', novalidate: 'novalidate' } }) }}
    {{ form_errors(form) }}

    <div>
        {{ form_label(form.name, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
        {{ form_widget(form.name, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.name) }}</div>
    </div>

    <div>
        {{ form_label(form.color, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
        {{ form_widget(form.color, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.color) }}</div>
    </div>

    <div>
        {{ form_label(form.description, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
        {{ form_widget(form.description, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500', 'data-controller': 'easymde', rows: 10 } }) }}
        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.description) }}</div>
    </div>

    <div>
        {{ form_label(form.manager, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
        {{ form_widget(form.manager, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.manager) }}</div>
    </div>

    <details class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <summary class="cursor-pointer px-6 py-4 text-sm font-semibold text-gray-900">{{ form.icon.vars.label }}</summary>
        <div class="border-t border-gray-200 px-6 py-4">
            {% if department.icon %}
                <div data-media-selector>
                    {{ include('admin/_media_item_card.html.twig', {
                        media_item: department.icon,
                        media_url: media_url,
                        title: 'Aktuelles Icon'|trans,
                        selector_content: '
                            <div class="space-y-3">
                                <p class="text-sm font-medium text-gray-900">' ~ 'Icon auswählen'|trans ~ '</p>
                                <div class="flex flex-wrap gap-2">
                                    <button type="button" class="inline-flex items-center rounded-lg border border-blue-700 px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-300" data-media-selector-open>
                                        <i class="fa-solid fa-image" aria-hidden="true"></i><span class="ml-2">' ~ 'Auswählen'|trans ~ '</span>
                                    </button>
                                    <button type="button" class="inline-flex items-center rounded-lg border border-red-700 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus:ring-4 focus:ring-red-300" data-media-selector-remove >
                                        <i class="fa-solid fa-trash" aria-hidden="true"></i><span class="ml-2">' ~ 'Entfernen'|trans ~ '</span>
                                    </button>
                                </div>
                            </div>
                        '
                    }) }}
                    {{ form_widget(form.icon) }}
                </div>
            {% else %}
                <div data-media-selector>
                    <div data-media-selector-preview class="admin-media-selector-preview"></div>
                    {{ form_widget(form.icon) }}
                    <div class="mt-3 flex flex-wrap gap-2">
                        <button type="button" class="inline-flex items-center rounded-lg border border-blue-700 px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-300" data-media-selector-open>
                            <i class="fa-solid fa-image" aria-hidden="true"></i><span class="ml-2">{{ 'Auswählen'|trans }}</span>
                        </button>
                        <button type="button" class="inline-flex items-center rounded-lg border border-red-700 px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus:ring-4 focus:ring-red-300" data-media-selector-remove  disabled>
                            <i class="fa-solid fa-trash" aria-hidden="true"></i><span class="ml-2">{{ 'Entfernen'|trans }}</span>
                        </button>
                    </div>
                </div>
            {% endif %}
        </div>
    </details>

    <details class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <summary class="cursor-pointer px-6 py-4 text-sm font-semibold text-gray-900">{{ form.departmentStats.vars.label }}</summary>
        <div class="border-t border-gray-200 px-6 py-4">
            <div class="collection-holder department-stats-collection space-y-3" data-prototype="{{ form_widget(form.departmentStats.vars.prototype)|e('html_attr') }}" data-index="{{ form.departmentStats|length }}">
                {% for stat in form.departmentStats %}
                    <div class="collection-item rounded-lg border border-gray-200 bg-gray-50 p-4">
                        <div class="grid gap-4 md:grid-cols-2">
                            <div>
                                {{ form_label(stat.label, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                {{ form_widget(stat.label, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                <div class="mt-2 text-sm text-red-600">{{ form_errors(stat.label) }}</div>
                            </div>
                            <div>
                                {{ form_label(stat.value, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                {{ form_widget(stat.value, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                <div class="mt-2 text-sm text-red-600">{{ form_errors(stat.value) }}</div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="button" class="js-remove-collection-item text-sm font-medium text-red-600 hover:underline" aria-label="Statistik entfernen">Entfernen</button>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="mt-4">
                <button type="button" class="js-add-stat inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Statistik hinzufügen</button>
            </div>
        </div>
    </details>

    <details class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <summary class="cursor-pointer px-6 py-4 text-sm font-semibold text-gray-900">{{ form.trainingGroups.vars.label }}</summary>
        <div class="border-t border-gray-200 px-6 py-4">
            <div class="collection-holder department-training-groups-collection space-y-4" data-prototype="{{ form_widget(form.trainingGroups.vars.prototype)|e('html_attr') }}" data-index="{{ form.trainingGroups|length }}">
                {% for group in form.trainingGroups %}
                    <div class="collection-item relative rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
                        <button type="button" class="js-remove-group absolute right-3 top-3 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Trainingsgruppe entfernen"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                        <div class="pr-12">
                            <div class="mb-4">
                                {{ form_label(group.name, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                {{ form_widget(group.name, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                {% if group.name.vars.help %}<p class="mt-2 text-sm text-gray-500">{{ group.name.vars.help }}</p>{% endif %}
                                <div class="mt-2 text-sm text-red-600">{{ form_errors(group.name) }}</div>
                            </div>
                            <div class="mb-4">
                                {{ form_label(group.ageRange, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                {{ form_widget(group.ageRange, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                {% if group.ageRange.vars.help %}<p class="mt-2 text-sm text-gray-500">{{ group.ageRange.vars.help }}</p>{% endif %}
                                <div class="mt-2 text-sm text-red-600">{{ form_errors(group.ageRange) }}</div>
                            </div>

                            <h4 class="mb-3 text-sm font-semibold text-gray-900">{{ group.departmentTrainingSessions.vars.label }}</h4>
                            <div class="text-sm text-red-600">{{ form_errors(group.departmentTrainingSessions) }}</div>
                            <div class="collection-holder department-training-sessions-collection space-y-3" data-prototype="{{ form_widget(group.departmentTrainingSessions.vars.prototype)|e('html_attr') }}" data-index="{{ group.departmentTrainingSessions|length }}">
                                {% for session in group.departmentTrainingSessions %}
                                    <div class="collection-item relative rounded-lg border border-gray-200 bg-gray-50 p-4">
                                        <button type="button" class="js-remove-session absolute right-3 top-3 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Trainingseinheit entfernen"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                                        <div class="pr-12">
                                            <div class="mb-4">
                                                {{ form_label(session.day, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                                {{ form_widget(session.day, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                                {% if session.day.vars.help %}<p class="mt-2 text-sm text-gray-500">{{ session.day.vars.help }}</p>{% endif %}
                                                <div class="mt-2 text-sm text-red-600">{{ form_errors(session.day) }}</div>
                                            </div>
                                            <div class="mb-4">
                                                {{ form_label(session.time, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                                {{ form_widget(session.time, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                                {% if session.time.vars.help %}<p class="mt-2 text-sm text-gray-500">{{ session.time.vars.help }}</p>{% endif %}
                                                <div class="mt-2 text-sm text-red-600">{{ form_errors(session.time) }}</div>
                                            </div>
                                            <div>
                                                {{ form_label(session.location, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                                {{ form_widget(session.location, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                                <div class="mt-2 text-sm text-red-600">{{ form_errors(session.location) }}</div>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                            <div class="mt-4">
                                <button type="button" class="js-add-session inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Trainingseinheit hinzufügen</button>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="mt-4">
                <button type="button" class="js-add-group inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Trainingsgruppe hinzufügen</button>
            </div>
        </div>
    </details>

    <details class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <summary class="cursor-pointer px-6 py-4 text-sm font-semibold text-gray-900">{{ form.departmentResults.vars.label }}</summary>
        <div class="border-t border-gray-200 px-6 py-4">
            <div class="collection-holder department-results-collection space-y-3" data-prototype="{{ form_widget(form.departmentResults.vars.prototype)|e('html_attr') }}" data-index="{{ form.departmentResults|length }}">
                {% for result in form.departmentResults %}
                    <div class="collection-item rounded-lg border border-gray-200 bg-gray-50 p-4">
                        <div class="grid gap-4 md:grid-cols-3">
                            <div>
                                {{ form_label(result.title, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                {{ form_widget(result.title, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                <div class="mt-2 text-sm text-red-600">{{ form_errors(result.title) }}</div>
                            </div>
                            <div>
                                {{ form_label(result.league, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                {{ form_widget(result.league, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                <div class="mt-2 text-sm text-red-600">{{ form_errors(result.league) }}</div>
                            </div>
                            <div>
                                {{ form_label(result.url, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                                {{ form_widget(result.url, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                                <div class="mt-2 text-sm text-red-600">{{ form_errors(result.url) }}</div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="button" class="js-remove-collection-item text-sm font-medium text-red-600 hover:underline" aria-label="Ergebnisdienst entfernen">Entfernen</button>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="mt-4">
                <button type="button" class="js-add-result inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Ergebnisdienst hinzufügen</button>
            </div>
        </div>
    </details>

    <div class="flex items-center gap-3">
        <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300">Speichern</button>
        <a href="{{ path('admin_department_index') }}" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Abbrechen</a>
    </div>
{{ form_end(form) }}

<script>
(function () {
    var fieldClass = 'block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500';
    var labelClass = 'mb-2 block text-sm font-medium text-gray-900';
    var helpClass = 'mt-2 text-sm text-gray-500';

    function applyFieldClasses(root) {
        root.querySelectorAll('input, select, textarea').forEach(function (field) {
            if (field.type === 'hidden') {
                return;
            }
            field.className = fieldClass;
        });

        root.querySelectorAll('label').forEach(function (label) {
            label.className = labelClass;
        });

        root.querySelectorAll('small, .form-text').forEach(function (help) {
            help.className = helpClass;
        });
    }

    function bindRemove(btn) {
        btn.addEventListener('click', function () {
            btn.closest('.collection-item').remove();
        });
    }

    function removeCardButtonHtml(jsClass, ariaLabel) {
        return '<button type="button" class="' + jsClass + ' absolute right-3 top-3 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-red-700 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="' + ariaLabel + '"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>';
    }

    function textRemoveButtonHtml(label, ariaLabel) {
        return '<div class="mt-3"><button type="button" class="js-remove-collection-item text-sm font-medium text-red-600 hover:underline" aria-label="' + ariaLabel + '">' + label + '</button></div>';
    }

    function bindAddSession(btn) {
        btn.addEventListener('click', function () {
            var groupCard = btn.closest('.collection-item');
            var holder = groupCard.querySelector('.department-training-sessions-collection');
            var proto = holder.dataset.prototype;
            var sidx = parseInt(holder.dataset.index, 10);
            var div = document.createElement('div');
            div.className = 'collection-item relative rounded-lg border border-gray-200 bg-gray-50 p-4';
            div.innerHTML = removeCardButtonHtml('js-remove-session', 'Trainingseinheit entfernen') + '<div class="pr-12">' + proto.replace(/__session__/g, String(sidx)) + '</div>';
            holder.appendChild(div);
            holder.dataset.index = String(sidx + 1);
            applyFieldClasses(div);
            bindRemove(div.querySelector('.js-remove-session'));
        });
    }

    document.querySelectorAll('.js-add-stat').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var holder = document.querySelector('.department-stats-collection');
            var proto = holder.dataset.prototype;
            var idx = parseInt(holder.dataset.index, 10);

            var temp = document.createElement('div');
            temp.innerHTML = proto.replace(/__stat__/g, String(idx));
            var inputs = temp.querySelectorAll('input');
            var labelInput = inputs.length >= 1 ? inputs[0].outerHTML : '';
            var valueInput = inputs.length >= 2 ? inputs[1].outerHTML : '';

            var div = document.createElement('div');
            div.className = 'collection-item rounded-lg border border-gray-200 bg-gray-50 p-4';
            div.innerHTML =
                '<div class="grid gap-4 md:grid-cols-2">' +
                    '<div><label>Bezeichnung</label>' + labelInput + '</div>' +
                    '<div><label>Wert</label>' + valueInput + '</div>' +
                '</div>' +
                textRemoveButtonHtml('Entfernen', 'Statistik entfernen');

            holder.appendChild(div);
            holder.dataset.index = String(idx + 1);
            applyFieldClasses(div);
            bindRemove(div.querySelector('.js-remove-collection-item'));
        });
    });

    document.querySelectorAll('.department-stats-collection .js-remove-collection-item').forEach(bindRemove);

    document.querySelectorAll('.js-add-result').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var holder = document.querySelector('.department-results-collection');
            var proto = holder.dataset.prototype;
            var idx = parseInt(holder.dataset.index, 10);

            var temp = document.createElement('div');
            temp.innerHTML = proto.replace(/__result__/g, String(idx));
            var inputs = temp.querySelectorAll('input');
            var titleInput = inputs.length >= 1 ? inputs[0].outerHTML : '';
            var leagueInput = inputs.length >= 2 ? inputs[1].outerHTML : '';
            var urlInput = inputs.length >= 3 ? inputs[2].outerHTML : '';

            var div = document.createElement('div');
            div.className = 'collection-item rounded-lg border border-gray-200 bg-gray-50 p-4';
            div.innerHTML =
                '<div class="grid gap-4 md:grid-cols-3">' +
                    '<div><label>Titel</label>' + titleInput + '</div>' +
                    '<div><label>Liga</label>' + leagueInput + '</div>' +
                    '<div><label>URL</label>' + urlInput + '</div>' +
                '</div>' +
                textRemoveButtonHtml('Entfernen', 'Ergebnisdienst entfernen');

            holder.appendChild(div);
            holder.dataset.index = String(idx + 1);
            applyFieldClasses(div);
            bindRemove(div.querySelector('.js-remove-collection-item'));
        });
    });

    document.querySelectorAll('.department-results-collection .js-remove-collection-item').forEach(bindRemove);

    document.querySelectorAll('.js-add-group').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var holder = document.querySelector('.department-training-groups-collection');
            var proto = holder.dataset.prototype;
            var idx = parseInt(holder.dataset.index, 10);
            var html = proto.replace(/__session__/g, '0').replace(/__group__/g, String(idx));
            var div = document.createElement('div');
            div.className = 'collection-item relative rounded-xl border border-gray-200 bg-white p-4 shadow-sm';
            div.innerHTML = removeCardButtonHtml('js-remove-group', 'Trainingsgruppe entfernen') + '<div class="pr-12">' + html + '<div class="mt-4"><button type="button" class="js-add-session inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Trainingseinheit hinzufügen</button></div></div>';
            holder.appendChild(div);
            holder.dataset.index = String(idx + 1);
            var sessionsHolder = div.querySelector('.department-training-sessions-collection');
            if (sessionsHolder) {
                sessionsHolder.dataset.index = String(div.querySelectorAll('.department-training-sessions-collection > .collection-item').length);
            }
            applyFieldClasses(div);
            bindAddSession(div.querySelector('.js-add-session'));
            bindRemove(div.querySelector('.js-remove-group'));
            div.querySelectorAll('.js-remove-session').forEach(bindRemove);
        });
    });

    document.querySelectorAll('.js-add-session').forEach(bindAddSession);
    document.querySelectorAll('.js-remove-group').forEach(bindRemove);
    document.querySelectorAll('.js-remove-session').forEach(bindRemove);
    applyFieldClasses(document.querySelector('.department-form'));
})();
</script>
