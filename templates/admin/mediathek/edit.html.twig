{% extends 'admin/layout.html.twig' %}

{% block title %}Medien bearbeiten - VSG Admin{% endblock %}

{% block content %}
    {% form_theme form 'form_div_layout.html.twig' %}

    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h1 class="text-2xl font-semibold text-gray-900">Medien bearbeiten</h1>
        <a href="{% if item.folder %}{{ path('admin_mediathek_index', {folder: item.folder.id}) }}{% else %}{{ path('admin_mediathek_index') }}{% endif %}" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Zurück</a>
    </div>

    {% set file_url = media_url.buildOriginalUrl(item) %}
    {% set thumbnail_url = media_url.buildThumbnailUrl(item) %}
    {% set is_image = item.type.value == 'image' %}
    {% set preview_url = is_image and thumbnail_url and item.mimeType not in ['image/svg+xml', 'image/gif'] ? thumbnail_url : file_url %}
    {% set is_describable_image = is_image and item.mimeType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif'] %}
    {% set is_croppable = is_image and item.mimeType in ['image/jpeg', 'image/png', 'image/webp'] %}
    {% set can_regenerate_thumbnail = is_image and item.mimeType in ['image/jpeg', 'image/png', 'image/webp'] %}

    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
    {{ form_errors(form) }}

    <div class="grid gap-4 lg:grid-cols-12">
        <div class="lg:col-span-5">
            <div class="h-full overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
                <div class="border-b border-gray-200 px-6 py-4">
                    <h2 class="text-lg font-semibold text-gray-900">Aktuelles Medium</h2>
                </div>
                <div class="px-6 py-4">
                    {% if is_image %}
                        <div class="mb-3 text-center">
                            <img src="{{ preview_url }}" alt="{{ item.name|e('html_attr') }}" class="admin-media-edit-preview rounded-lg border border-gray-200">
                        </div>
                        <p class="mb-0 break-words text-sm text-gray-500">{{ item.name }} · {{ media_url.formatSizeHuman(item.sizeBytes) }}</p>
                    {% else %}
                        <div class="mb-3 text-center text-red-600" aria-hidden="true">
                            <i class="fa-solid fa-file-pdf text-5xl"></i>
                        </div>
                        <p class="mb-1 break-words font-medium text-gray-900">{{ item.originalFilename }}</p>
                        <p class="mb-2 text-sm text-gray-500">{{ media_url.formatSizeHuman(item.sizeBytes) }}</p>
                        <p class="mb-0 text-sm text-gray-500">Für PDF-Dateien wird keine Vorschau angezeigt.</p>
                    {% endif %}

                    {% if file_url or thumbnail_url %}
                        <div class="mt-4 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 space-y-3">
                            {% if file_url %}
                                <div>
                                    <p class="mb-1 text-sm font-medium text-gray-900">URL</p>
                                    <a href="{{ file_url }}" target="_blank" rel="noopener noreferrer" class="break-all text-sm text-blue-700 hover:underline">{{ file_url }}</a>
                                </div>
                            {% endif %}
                            {% if thumbnail_url %}
                                <div>
                                    <p class="mb-1 text-sm font-medium text-gray-900">Thumbnail-URL</p>
                                    <a href="{{ thumbnail_url }}" target="_blank" rel="noopener noreferrer" class="break-all text-sm text-blue-700 hover:underline">{{ thumbnail_url }}</a>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="lg:col-span-7">
            <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
                <div class="px-6 py-4 space-y-4">
                    <div>
                        {{ form_label(form.name, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                        {{ form_widget(form.name, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.name) }}</div>
                    </div>

                    <div
                        data-controller="easymde"
                        data-easymde-improve-url-value="{{ path('admin_mediathek_item_describe', { id: item.id }) }}"
                        data-easymde-csrf-token-value="{{ csrf_token('describe_media_item' ~ item.id) }}"
                        data-easymde-require-content-value="false"
                    >
                        <div class="mb-2 flex items-center justify-between gap-3">
                            {{ form_label(form.description, null, { label_attr: { class: 'mb-0 block text-sm font-medium text-gray-900' } }) }}
                            {% if is_describable_image %}
                                <button
                                    type="button"
                                    class="inline-flex items-center rounded-lg border border-blue-700 px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-300 disabled:cursor-not-allowed disabled:opacity-60"
                                    data-easymde-target="button"
                                    data-action="click->easymde#improve"
                                >
                                    <i class="fa-solid fa-robot" aria-hidden="true"></i><span class="ml-2">Bild beschreiben</span>
                                </button>
                            {% endif %}
                        </div>
                        {{ form_widget(form.description, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500', 'data-easymde-target': 'input' } }) }}
                        <div class="mt-2 hidden text-sm text-red-600" data-easymde-target="error"></div>
                        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.description) }}</div>

                        <div id="mediaItemDescriptionModal" tabindex="-1" aria-labelledby="mediaItemDescriptionModalLabel" aria-hidden="true" class="fixed inset-0 z-50 hidden overflow-y-auto overflow-x-hidden p-4" data-easymde-target="modal">
                            <div class="fixed inset-0 bg-gray-900/60" aria-hidden="true"></div>

                            <div class="relative z-10 flex min-h-full items-center justify-center">
                                <div class="w-full max-w-5xl">
                                    <div class="relative flex max-h-[calc(100vh-2rem)] flex-col overflow-hidden rounded-lg bg-white shadow-xl">
                                        <div class="flex items-center justify-between rounded-t border-b border-gray-200 px-4 py-3 md:px-5">
                                            <h2 class="text-lg font-semibold text-gray-900" id="mediaItemDescriptionModalLabel">Bildbeschreibung</h2>
                                            <button type="button" class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500" data-action="click->easymde#closeModal" aria-label="Schließen">
                                                <svg class="h-4 w-4" aria-hidden="true" fill="none" viewBox="0 0 14 14" stroke="currentColor" stroke-width="1.5">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="m1 1 12 12M13 1 1 13" />
                                                </svg>
                                            </button>
                                        </div>
                                        <div class="min-h-0 flex-1 overflow-y-auto p-4 md:p-5">
                                            <div class="py-8 text-center" data-easymde-target="modalLoading">
                                                <svg class="mx-auto h-8 w-8 animate-spin text-gray-400" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4Z"></path>
                                                </svg>
                                                <p class="mt-3 text-sm text-gray-500">Bild wird beschrieben…</p>
                                            </div>

                                            <div class="hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" data-easymde-target="modalError"></div>

                                            <div class="hidden space-y-4" data-easymde-target="modalBody">
                                                <div class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800" role="alert">
                                                    Verwendetes Modell:
                                                    <a href="#" target="_blank" rel="noopener noreferrer" class="font-medium underline hover:no-underline" data-easymde-target="modelLink">
                                                        <span data-easymde-target="modelName"></span>
                                                    </a>
                                                </div>

                                                <div>
                                                    <label for="media_item_description_preview" class="mb-2 block text-sm font-medium text-gray-900">Vorschlag</label>
                                                    <textarea id="media_item_description_preview" class="block w-full" data-easymde-target="previewInput"></textarea>
                                                </div>

                                                <details class="rounded-lg border border-gray-200 bg-gray-50">
                                                    <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-gray-900">System-Prompt</summary>
                                                    <div class="border-t border-gray-200 px-4 py-3">
                                                        <pre class="whitespace-pre-wrap break-words text-sm text-gray-700" data-easymde-target="prompt"></pre>
                                                    </div>
                                                </details>
                                            </div>
                                        </div>
                                        <div class="flex items-center justify-end gap-3 rounded-b border-t border-gray-200 px-4 py-3 md:px-5">
                                            <button type="button" class="rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200" data-action="click->easymde#closeModal">Abbrechen</button>
                                            <button type="button" class="rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300 disabled:cursor-not-allowed disabled:opacity-60" data-easymde-target="applyButton" data-action="click->easymde#apply" disabled>Übernehmen</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div>
                        {{ form_label(form.category, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                        {{ form_widget(form.category, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.category) }}</div>
                    </div>

                    <div>
                        {{ form_label(form.folder, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                        {{ form_widget(form.folder, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.folder) }}</div>
                    </div>

                    <div>
                        <label class="inline-flex items-center gap-3 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-900">
                            {{ form_widget(form.isHiddenInApi, { attr: { class: 'h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500' } }) }}
                            <span>{{ form.isHiddenInApi.vars.label }}</span>
                        </label>
                        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.isHiddenInApi) }}</div>
                    </div>

                    {% if not is_croppable %}
                        <div class="hidden">
                            {{ form_widget(form.cropX) }}
                            {{ form_widget(form.cropY) }}
                            {{ form_widget(form.cropWidth) }}
                            {{ form_widget(form.cropHeight) }}
                        </div>
                    {% endif %}

                    <div class="flex flex-wrap gap-2">
                        <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300">Speichern</button>
                        {% if can_regenerate_thumbnail %}
                            <button type="submit" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200" form="regenerate-thumbnail-form">
                                <i class="fa-solid fa-image" aria-hidden="true"></i><span class="ml-2">Thumbnail neu erzeugen</span>
                            </button>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if is_croppable %}
        <div class="mt-4 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm"
             data-controller="image-cropper"
             data-image-cropper-initial-x-value="{{ form.cropX.vars.value|default('0') }}"
             data-image-cropper-initial-y-value="{{ form.cropY.vars.value|default('0') }}"
             data-image-cropper-initial-width-value="{{ form.cropWidth.vars.value|default('0') }}"
             data-image-cropper-initial-height-value="{{ form.cropHeight.vars.value|default('0') }}">
            <div class="border-b border-gray-200 px-6 py-4">
                <h2 class="text-lg font-semibold text-gray-900">Bildeditor</h2>
            </div>
            <div class="px-6 py-4">
                <div class="admin-cropper-container mb-4">
                    <img src="{{ file_url }}" alt="{{ item.name|e('html_attr') }}" data-image-cropper-target="image" style="max-width: 100%; display: block;">
                </div>

                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                    <div>
                        <label class="mb-2 block text-sm font-medium text-gray-900" for="{{ form.cropX.vars.id }}">X</label>
                        {{ form_widget(form.cropX, { attr: { 'data-image-cropper-target': 'cropX', 'data-action': 'input->image-cropper#syncCropperFromFields', 'class': 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.cropX) }}</div>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-medium text-gray-900" for="{{ form.cropY.vars.id }}">Y</label>
                        {{ form_widget(form.cropY, { attr: { 'data-image-cropper-target': 'cropY', 'data-action': 'input->image-cropper#syncCropperFromFields', 'class': 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.cropY) }}</div>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-medium text-gray-900" for="{{ form.cropWidth.vars.id }}">Breite</label>
                        {{ form_widget(form.cropWidth, { attr: { 'data-image-cropper-target': 'cropWidth', 'data-action': 'input->image-cropper#syncCropperFromFields', 'class': 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.cropWidth) }}</div>
                    </div>
                    <div>
                        <label class="mb-2 block text-sm font-medium text-gray-900" for="{{ form.cropHeight.vars.id }}">Höhe</label>
                        {{ form_widget(form.cropHeight, { attr: { 'data-image-cropper-target': 'cropHeight', 'data-action': 'input->image-cropper#syncCropperFromFields', 'class': 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.cropHeight) }}</div>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="button" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200" data-action="image-cropper#resetCrop">
                        <i class="fa-solid fa-rotate-left" aria-hidden="true"></i><span class="ml-2">Zurücksetzen</span>
                    </button>
                </div>
            </div>
        </div>
    {% endif %}

    {{ form_widget(form._token) }}
    {{ form_end(form, { render_rest: false }) }}

    {% if can_regenerate_thumbnail %}
        <form id="regenerate-thumbnail-form" method="post" action="{{ path('admin_mediathek_item_thumbnail_regenerate', {id: item.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('regenerate_thumbnail_media_item' ~ item.id) }}">
        </form>
    {% endif %}
{% endblock %}
