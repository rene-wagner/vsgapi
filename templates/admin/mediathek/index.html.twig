{% extends 'admin/layout.html.twig' %}

{% block title %}Mediathek - VSG Admin{% endblock %}

{% block content %}
    {% form_theme upload_form 'form_div_layout.html.twig' %}

    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h1 class="text-2xl font-semibold text-gray-900">Mediathek</h1>
        <div class="flex flex-wrap gap-2">
            <a href="{{ path('admin_media_folder_index') }}" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Ordner verwalten</a>
            <a href="{{ path('admin_media_folder_new') }}" class="inline-flex items-center justify-center rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300">Neuer Ordner</a>
        </div>
    </div>

    <div class="mb-4 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-200 px-6 py-4">
            <h2 class="text-lg font-semibold text-gray-900">Dateien</h2>
        </div>
        <div class="border-b border-gray-200 px-6 py-4">
            <nav aria-label="Ordnerpfad" class="space-y-2">
                <span class="block text-sm font-semibold text-gray-900">Speicherort</span>
                <ol class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
                    {% if current_folder %}
                        <li><a href="{{ path('admin_mediathek_index') }}" class="font-medium text-blue-700 hover:underline">Mediathek</a></li>
                        {% for f in folder_breadcrumb %}
                            <li aria-hidden="true" class="text-gray-400">/</li>
                            {% if loop.last %}
                                <li class="font-medium text-gray-900" aria-current="page">{{ f.name }}</li>
                            {% else %}
                                <li><a href="{{ path('admin_mediathek_index', {folder: f.id}) }}" class="font-medium text-blue-700 hover:underline">{{ f.name }}</a></li>
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        <li class="font-medium text-gray-900" aria-current="page">Mediathek</li>
                    {% endif %}
                </ol>
            </nav>
        </div>

        {% if folders_at_level is empty and items is empty %}
            <div class="px-6 py-10 text-center text-sm text-gray-500">Keine Ordner oder Dateien in dieser Ebene.</div>
        {% else %}
            <div class="divide-y divide-gray-200">
                {% for subfolder in folders_at_level %}
                    <a href="{{ path('admin_mediathek_index', {folder: subfolder.id}) }}" class="admin-mediathek-row flex flex-col gap-3 px-6 py-4 text-decoration-none sm:flex-row sm:items-center hover:bg-gray-50">
                        <div class="flex min-w-0 flex-1 items-center gap-3">
                            <span class="admin-mediathek-folder-icon inline-flex flex-shrink-0 items-center justify-center rounded-lg bg-gray-100" aria-hidden="true">
                                <i class="fa-solid fa-folder text-amber-500"></i>
                            </span>
                            <div class="min-w-0">
                                <div class="truncate font-medium text-gray-900">{{ subfolder.name }}</div>
                                <div class="text-sm text-gray-500">Ordner</div>
                            </div>
                        </div>
                        <div class="hidden flex-shrink-0 text-sm text-gray-400 sm:block">
                            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                        </div>
                    </a>
                {% endfor %}

                {% for item in items %}
                    {% set file_url = media_url.buildOriginalUrl(item) %}
                    {% set thumb_url = media_url.buildThumbnailUrl(item) %}
                    <div class="admin-mediathek-row flex flex-col gap-3 px-6 py-4 md:flex-row md:items-start hover:bg-gray-50">
                        <div class="flex min-w-0 flex-1 gap-3">
                            <div class="flex-shrink-0">
                                {% if item.type.value == 'image' %}
                                    {% if item.mimeType in ['image/svg+xml', 'image/gif'] %}
                                        <img src="{{ file_url }}" alt="" class="admin-media-thumb rounded-lg">
                                    {% else %}
                                        <img src="{{ thumb_url ?? file_url }}" alt="" class="admin-media-thumb rounded-lg">
                                    {% endif %}
                                {% else %}
                                    <span class="admin-mediathek-pdf-badge inline-flex items-center justify-center rounded-lg bg-gray-100 text-xs font-semibold uppercase tracking-wide text-gray-700">PDF</span>
                                {% endif %}
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="break-words font-medium text-gray-900">{{ item.name }}</div>
                                <div class="text-sm text-gray-500">{{ item.type.value }} · {{ media_url.formatSizeHuman(item.sizeBytes) }}</div>
                            </div>
                        </div>
                        <div class="admin-mediathek-row-actions flex flex-wrap items-start gap-2">
                            <a href="{{ path('admin_mediathek_item_edit', {id: item.id}) }}" class="inline-flex items-center rounded-lg bg-blue-700 px-3 py-2 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" aria-label="Bearbeiten" title="Bearbeiten"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></a>
                            <form method="post" action="{{ path('admin_mediathek_item_delete', {id: item.id}) }}" onsubmit="return confirm('Wirklich löschen?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_media_item' ~ item.id) }}">
                                <button type="submit" class="inline-flex items-center rounded-lg bg-red-700 px-3 py-2 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Löschen" title="Löschen"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-200 px-6 py-4">
            <h2 class="text-lg font-semibold text-gray-900">Dateien hochladen</h2>
        </div>
        <div class="px-6 py-4">
            {% if current_folder %}
                <p class="mb-3 text-sm text-gray-500">Die Dateien werden in den Ordner <strong>{{ current_folder.name }}</strong> gelegt.</p>
            {% else %}
                <p class="mb-3 text-sm text-gray-500">Die Dateien werden auf der obersten Mediathek-Ebene abgelegt.</p>
            {% endif %}

            {{ form_start(upload_form, { attr: { class: 'space-y-6', enctype: 'multipart/form-data', novalidate: 'novalidate' } }) }}
                <div data-controller="mediathek-dropzone">
                    {{ form_label(upload_form.files, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                    <button type="button" class="admin-mediathek-dropzone w-full rounded-xl border-2 border-dashed border-gray-300 bg-gray-50 p-6 text-center text-gray-500" data-mediathek-dropzone-target="dropzone" data-action="click->mediathek-dropzone#openPicker dragenter->mediathek-dropzone#dragEnter dragleave->mediathek-dropzone#dragLeave dragover->mediathek-dropzone#dragOver drop->mediathek-dropzone#drop" aria-label="Dateien auswählen oder per Drag-and-Drop hinzufügen">
                        <span class="inline-flex flex-col items-center gap-2">
                            <i class="fa-solid fa-cloud-arrow-up text-3xl text-gray-400" aria-hidden="true"></i>
                            <span class="text-sm font-medium text-gray-900">Dateien hierher ziehen</span>
                            <span class="text-sm text-gray-500">oder klicken, um mehrere Dateien auszuwählen</span>
                        </span>
                    </button>
                    <div class="hidden">
                        {{ form_widget(upload_form.files, { attr: { 'data-mediathek-dropzone-target': 'input', 'data-action': 'change->mediathek-dropzone#updateList' } }) }}
                    </div>
                    <div class="mt-2 text-sm text-red-600">{{ form_errors(upload_form.files) }}</div>
                    <p class="admin-mediathek-selected-files mt-2 text-sm text-gray-500" data-mediathek-dropzone-target="list" hidden></p>
                </div>

                <div>
                    {{ form_label(upload_form.category, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                    {{ form_widget(upload_form.category, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                    <div class="mt-2 text-sm text-red-600">{{ form_errors(upload_form.category) }}</div>
                    {% if upload_form.category.vars.help %}
                        <p class="mt-2 text-sm text-gray-500">{{ upload_form.category.vars.help }}</p>
                    {% endif %}
                </div>

                <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300">Hochladen</button>
            {{ form_end(upload_form) }}
        </div>
    </div>
{% endblock %}
