{% extends 'admin/layout.html.twig' %}

{% block title %}{{ post.title }} - Beiträge - VSG Admin{% endblock %}

{% block content %}
    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h1 class="text-2xl font-semibold text-gray-900">{{ post.title }}</h1>
        <div class="flex flex-wrap gap-2">
            <a href="{{ path('admin_post_edit', {id: post.id}) }}" class="inline-flex items-center rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" aria-label="Bearbeiten" title="Bearbeiten"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></a>
            <a href="{{ path('admin_post_index') }}" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Zurück</a>
        </div>
    </div>

    <div class="mb-4 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <dl class="divide-y divide-gray-200">
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4"><dt class="text-sm font-medium uppercase tracking-wide text-gray-500">ID</dt><dd class="text-sm text-gray-900 sm:col-span-2">{{ post.id }}</dd></div>
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4"><dt class="text-sm font-medium uppercase tracking-wide text-gray-500">Slug</dt><dd class="sm:col-span-2"><span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800">{{ post.slug }}</span></dd></div>
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4"><dt class="text-sm font-medium uppercase tracking-wide text-gray-500">Autor</dt><dd class="text-sm text-gray-900 sm:col-span-2">{{ post.author.fullName }} ({{ post.author.email }})</dd></div>
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4"><dt class="text-sm font-medium uppercase tracking-wide text-gray-500">Kategorien</dt><dd class="sm:col-span-2">{% if post.categories|length > 0 %}<div class="flex flex-wrap gap-2">{% for category in post.categories %}<span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-800">{{ category.name }}</span>{% endfor %}</div>{% else %}<span class="text-sm text-gray-500">—</span>{% endif %}</dd></div>
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4"><dt class="text-sm font-medium uppercase tracking-wide text-gray-500">Veröffentlicht</dt><dd class="text-sm text-gray-900 sm:col-span-2">{{ post.published ? 'Ja' : 'Nein' }}</dd></div>
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4"><dt class="text-sm font-medium uppercase tracking-wide text-gray-500">Aufrufe</dt><dd class="text-sm text-gray-900 sm:col-span-2">{{ post.hits }}</dd></div>
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4"><dt class="text-sm font-medium uppercase tracking-wide text-gray-500">Alter Beitrag</dt><dd class="text-sm text-gray-900 sm:col-span-2">{{ post.oldPost ? 'Ja' : 'Nein' }}</dd></div>
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4"><dt class="text-sm font-medium uppercase tracking-wide text-gray-500">Erstellt am</dt><dd class="text-sm text-gray-900 sm:col-span-2">{{ post.createdAt|date('d.m.Y H:i') }}</dd></div>
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4"><dt class="text-sm font-medium uppercase tracking-wide text-gray-500">Zuletzt aktualisiert</dt><dd class="text-sm text-gray-900 sm:col-span-2">{{ post.updatedAt|date('d.m.Y H:i') }}</dd></div>
        </dl>
    </div>

    <div class="mb-4 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-200 px-6 py-4">
            <h2 class="text-lg font-semibold text-gray-900">Inhalt (Markdown)</h2>
        </div>
        <div class="px-6 py-4">
            <pre class="admin-pre-content rounded-lg border border-gray-200 bg-gray-50 p-4 text-sm text-gray-900">{{ post.content }}</pre>
        </div>
    </div>

    {% if post.picture %}
        {% include 'admin/_media_item_card.html.twig' with { media_item: post.picture, title: 'Bild' } %}
    {% endif %}

    <div class="overflow-hidden rounded-xl border border-red-200 bg-white shadow-sm">
        <div class="border-b border-red-200 bg-red-50 px-6 py-4">
            <h2 class="text-lg font-semibold text-red-700">Beitrag löschen</h2>
        </div>
        <div class="px-6 py-4">
            {{ include('admin/post/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
