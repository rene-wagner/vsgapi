{% extends 'admin/layout.html.twig' %}

{% block title %}Neuer Medien-Ordner - VSG Admin{% endblock %}

{% block content %}
    {% form_theme form 'form_div_layout.html.twig' %}

    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h1 class="text-2xl font-semibold text-gray-900">Neuer Medien-Ordner</h1>
        <a href="{{ path('admin_mediathek_index') }}" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Zurück</a>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        {{ form_start(form, { attr: { class: 'space-y-6', novalidate: 'novalidate' } }) }}
            {{ form_errors(form) }}

            <div>
                {{ form_label(form.name, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                {{ form_widget(form.name, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                <div class="mt-2 text-sm text-red-600">{{ form_errors(form.name) }}</div>
            </div>

            <div>
                {{ form_label(form.parent, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
                {{ form_widget(form.parent, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
                <div class="mt-2 text-sm text-red-600">{{ form_errors(form.parent) }}</div>
            </div>

            <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300">Speichern</button>
        {{ form_end(form) }}
    </div>
{% endblock %}
