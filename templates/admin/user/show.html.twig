{% extends 'admin/layout.html.twig' %}

{% block title %}{{ user.fullName }} - Benutzerverwaltung - VSG Admin{% endblock %}

{% block content %}
    <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h1 class="text-2xl font-semibold text-gray-900">{{ user.fullName }}</h1>
        <div class="flex flex-wrap gap-2">
            <a href="{{ path('admin_user_edit', {id: user.id}) }}" class="inline-flex items-center rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" aria-label="Bearbeiten" title="Bearbeiten"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i></a>
            <a href="{{ path('admin_user_index') }}" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Zurück</a>
        </div>
    </div>

    <div class="mb-4 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <dl class="divide-y divide-gray-200">
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4">
                <dt class="text-sm font-medium uppercase tracking-wide text-gray-500">ID</dt>
                <dd class="text-sm text-gray-900 sm:col-span-2">{{ user.id }}</dd>
            </div>
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4">
                <dt class="text-sm font-medium uppercase tracking-wide text-gray-500">E-Mail</dt>
                <dd class="text-sm text-gray-900 sm:col-span-2">{{ user.email }}</dd>
            </div>
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4">
                <dt class="text-sm font-medium uppercase tracking-wide text-gray-500">Vorname</dt>
                <dd class="text-sm text-gray-900 sm:col-span-2">{{ user.firstName }}</dd>
            </div>
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4">
                <dt class="text-sm font-medium uppercase tracking-wide text-gray-500">Nachname</dt>
                <dd class="text-sm text-gray-900 sm:col-span-2">{{ user.lastName }}</dd>
            </div>
            <div class="grid gap-2 px-6 py-4 sm:grid-cols-3 sm:gap-4">
                <dt class="text-sm font-medium uppercase tracking-wide text-gray-500">Rollen</dt>
                <dd class="sm:col-span-2">
                    <div class="flex flex-wrap gap-2">
                        {% for role in user.roles %}
                            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium {{ role == 'ROLE_ADMIN' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800' }}">{{ role }}</span>
                        {% endfor %}
                    </div>
                </dd>
            </div>
        </dl>
    </div>

    <div class="overflow-hidden rounded-xl border border-red-200 bg-white shadow-sm">
        <div class="border-b border-red-200 bg-red-50 px-6 py-4">
            <h2 class="text-lg font-semibold text-red-700">Benutzer löschen</h2>
        </div>
        <div class="px-6 py-4">
            <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}" onsubmit="return confirm('Sind Sie sicher, dass Sie diesen Benutzer löschen möchten?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                <button type="submit" class="inline-flex items-center rounded-lg bg-red-700 px-4 py-2.5 text-sm font-medium text-white hover:bg-red-800 focus:outline-none focus:ring-4 focus:ring-red-300" aria-label="Benutzer löschen" title="Benutzer löschen"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
            </form>
        </div>
    </div>
{% endblock %}
