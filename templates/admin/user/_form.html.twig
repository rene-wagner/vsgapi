{% form_theme form 'form_div_layout.html.twig' %}

{{ form_start(form, { attr: { class: 'space-y-6' } }) }}
    {{ form_errors(form) }}

    <div>
        {{ form_label(form.email, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
        {{ form_widget(form.email, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.email) }}</div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
        <div>
            {{ form_label(form.firstName, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
            {{ form_widget(form.firstName, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
            <div class="mt-2 text-sm text-red-600">{{ form_errors(form.firstName) }}</div>
        </div>

        <div>
            {{ form_label(form.lastName, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
            {{ form_widget(form.lastName, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
            <div class="mt-2 text-sm text-red-600">{{ form_errors(form.lastName) }}</div>
        </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
        <div>
            {{ form_label(form.plainPassword.first, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
            {{ form_widget(form.plainPassword.first, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
            <div class="mt-2 text-sm text-red-600">{{ form_errors(form.plainPassword.first) }}</div>
        </div>

        <div>
            {{ form_label(form.plainPassword.second, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
            {{ form_widget(form.plainPassword.second, { attr: { class: 'block w-full rounded-lg border border-gray-300 bg-gray-50 px-3 py-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500' } }) }}
            <div class="mt-2 text-sm text-red-600">{{ form_errors(form.plainPassword.second) }}</div>
        </div>
    </div>

    <div class="text-sm text-red-600">{{ form_errors(form.plainPassword) }}</div>

    {% if form.vars.data.id is not null %}
        <p class="text-sm text-gray-500">Leer lassen, um das bestehende Passwort beizubehalten.</p>
    {% endif %}

    <div>
        {{ form_label(form.roles, null, { label_attr: { class: 'mb-2 block text-sm font-medium text-gray-900' } }) }}
        <div class="space-y-3 rounded-lg border border-gray-200 bg-gray-50 p-4">
            {% for child in form.roles %}
                <label class="flex items-center gap-3 text-sm text-gray-900">
                    {{ form_widget(child, { attr: { class: 'h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500' } }) }}
                    <span>{{ child.vars.label }}</span>
                </label>
            {% endfor %}
        </div>
        <div class="mt-2 text-sm text-red-600">{{ form_errors(form.roles) }}</div>
    </div>

    <div class="flex items-center gap-3">
        <button type="submit" class="inline-flex items-center justify-center rounded-lg bg-blue-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300">Speichern</button>
        <a href="{{ path('admin_user_index') }}" class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-4 focus:ring-gray-200">Abbrechen</a>
    </div>
{{ form_end(form) }}
