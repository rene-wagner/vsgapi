{#
  media_item: App\Entity\MediaItem
  title: string (e.g. 'Bild', 'Icon')
#}
{% if media_item %}
<div class="mb-4 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="border-b border-gray-200 px-6 py-4 text-lg font-semibold text-gray-900">{{ title|default('Mediendatei') }}</div>
    <div class="px-6 py-4" data-media-selector-preview data-media-selector-preview-mode="card">
        <div class="grid gap-6 md:grid-cols-[150px_minmax(0,1fr)]">
            <div>
                {% if media_item.type.value == 'image' and media_item.thumbnailPath and media_item.mimeType not in ['image/svg+xml', 'image/gif'] %}
                    <img src="{{ media_url.buildThumbnailUrl(media_item) }}"
                         alt="{{ media_item.name }}"
                         class="h-auto max-h-[150px] w-full max-w-[150px] rounded-lg border border-gray-200 object-contain bg-white">
                {% elseif media_item.type.value == 'image' %}
                    <img src="{{ media_url.buildOriginalUrl(media_item) }}"
                         alt="{{ media_item.name }}"
                         class="h-auto max-h-[150px] w-full max-w-[150px] rounded-lg border border-gray-200 object-contain bg-white">
                {% else %}
                    <div class="flex h-[150px] w-[150px] items-center justify-center rounded-lg bg-gray-100">
                        {% if media_item.type.value == 'pdf' %}
                            <i class="fa-solid fa-file-pdf text-5xl text-red-600" aria-hidden="true"></i>
                        {% else %}
                            <i class="fa-solid fa-file text-5xl text-gray-500" aria-hidden="true"></i>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
            <div>
                <dl class="space-y-3 text-sm text-gray-700">
                    <div class="grid gap-1 sm:grid-cols-3 sm:gap-4"><dt class="font-medium text-gray-500">Name</dt><dd class="sm:col-span-2">{{ media_item.name }}</dd></div>
                    <div class="grid gap-1 sm:grid-cols-3 sm:gap-4"><dt class="font-medium text-gray-500">Typ</dt><dd class="sm:col-span-2">{% if media_item.type.value == 'image' %}Bild{% else %}PDF{% endif %}</dd></div>
                    <div class="grid gap-1 sm:grid-cols-3 sm:gap-4"><dt class="font-medium text-gray-500">Größe</dt><dd class="sm:col-span-2">{{ media_url.formatSizeHuman(media_item.sizeBytes) }}</dd></div>
                </dl>
                <a href="{{ path('admin_mediathek_item_edit', { id: media_item.id }) }}"
                   class="mt-4 inline-flex items-center rounded-lg border border-blue-700 px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-300"
                   aria-label="Bearbeiten" title="Bearbeiten">
                    <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
    {% if selector_content is defined and selector_content %}
    <div class="border-t border-gray-200 bg-gray-50 px-6 py-4">
        {{ selector_content|raw }}
    </div>
    {% endif %}
</div>
{% endif %}
