{#
  media_item: App\Entity\MediaItem
  title: string (e.g. 'Bild', 'Icon')
#}
{% if media_item %}
{% set wrapped = wrapped is defined ? wrapped : true %}
{% if wrapped %}
<div class="mb-4 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
    {% if title is defined and title is not empty %}
    <div class="border-b border-gray-200 px-6 py-4">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400">Ausgewählte Datei</p>
        <h3 class="mt-1 text-lg font-semibold text-gray-900">{{ title }}</h3>
    </div>
    {% endif %}
{% endif %}
    <div class="{% if wrapped %}px-6 py-5{% endif %}" data-media-selector-preview data-media-selector-preview-mode="card">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,220px)_minmax(0,1fr)] lg:items-center">
            <div class="flex justify-center lg:justify-start">
                {% if media_item.type.value == 'image' and media_item.thumbnailPath and media_item.mimeType not in ['image/svg+xml', 'image/gif'] %}
                    <img src="{{ media_url.buildThumbnailUrl(media_item) }}"
                         alt="{{ media_item.name }}"
                         class="h-[180px] w-[180px] rounded-2xl border border-gray-200 object-contain bg-gradient-to-br from-gray-50 to-white p-3 shadow-sm">
                {% elseif media_item.type.value == 'image' %}
                    <img src="{{ media_url.buildOriginalUrl(media_item) }}"
                         alt="{{ media_item.name }}"
                         class="h-[180px] w-[180px] rounded-2xl border border-gray-200 object-contain bg-gradient-to-br from-gray-50 to-white p-3 shadow-sm">
                {% else %}
                    <div class="flex h-[180px] w-[180px] items-center justify-center rounded-2xl border border-gray-200 bg-gradient-to-br from-gray-50 to-white shadow-sm">
                        {% if media_item.type.value == 'pdf' %}
                            <i class="fa-solid fa-file-pdf text-6xl text-red-600" aria-hidden="true"></i>
                        {% else %}
                            <i class="fa-solid fa-file text-6xl text-gray-500" aria-hidden="true"></i>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
            <div class="min-w-0">
                <h4 class="truncate text-base font-semibold text-gray-900">{{ media_item.name }}</h4>
                <div class="mt-3 flex flex-wrap gap-2">
                    <span class="inline-flex items-center rounded-full bg-blue-100 px-3 py-1 text-xs font-medium text-blue-800">{% if media_item.type.value == 'image' %}Bild{% else %}PDF{% endif %}</span>
                    <span class="inline-flex items-center rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700">{{ media_url.formatSizeHuman(media_item.sizeBytes) }}</span>
                </div>
                <p class="mt-4 text-sm text-gray-500">Sie können die aktuelle Datei austauschen oder in der Mediathek bearbeiten.</p>
                {% set show_edit_action = show_edit_action is defined ? show_edit_action : true %}
                {% if show_edit_action %}
                <div class="mt-5 flex flex-wrap gap-3">
                    <a href="{{ path('admin_mediathek_item_edit', { id: media_item.id }) }}"
                       class="inline-flex items-center rounded-lg border border-blue-700 px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-300"
                       aria-label="Bearbeiten" title="Bearbeiten">
                        <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><span class="ml-2">Bearbeiten</span>
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% if selector_content is defined and selector_content %}
    <div class="{% if wrapped %}border-t border-gray-200 bg-gray-50 px-6 py-4{% endif %}">
        {{ selector_content|raw }}
    </div>
    {% endif %}
{% if wrapped %}
</div>
{% endif %}
{% endif %}
