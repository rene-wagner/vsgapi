{% extends 'admin/layout.html.twig' %}

{% block title %}Seiteninhalt - VSG Admin{% endblock %}

{% block content %}
    <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-semibold text-gray-900">Seiteninhalt</h1>
            <p class="mt-1 text-sm text-gray-500">Eingebettete Ansicht von <a href="{{ iframe_url }}" target="_blank" rel="noopener noreferrer" class="font-medium text-blue-700 hover:underline">{{ iframe_url }}</a>.</p>
        </div>
    </div>

    <div class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm">
        <iframe src="{{ iframe_url }}" title="Seiteninhalt" class="block w-full border-0" style="min-height: 82vh;"></iframe>
    </div>
{% endblock %}
