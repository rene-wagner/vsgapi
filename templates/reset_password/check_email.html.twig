{% extends 'base.html.twig' %}

{% block title %}E-Mail versendet - VSG Admin{% endblock %}

{% block body %}
    <div class="flex min-h-screen items-center justify-center bg-gray-900 px-4 py-8">
        <div class="w-full max-w-md rounded-2xl bg-white p-8 text-center shadow-xl">
            <h1 class="mb-3 text-2xl font-semibold text-gray-900">E-Mail prüfen</h1>
            <p class="mb-3 text-sm text-gray-500">Wenn ein Benutzerkonto mit dieser E-Mail-Adresse existiert, wurde soeben eine Nachricht mit einem Link zum Zurücksetzen des Passworts versendet.</p>
            <p class="mb-6 text-sm text-gray-500">Der Link ist zeitlich begrenzt. Falls keine E-Mail ankommt, prüfen Sie bitte auch den Spam-Ordner.</p>
            <a href="{{ path('app_forgot_password_request') }}" class="inline-flex w-full items-center justify-center rounded-lg border border-blue-700 px-5 py-2.5 text-sm font-medium text-blue-700 hover:bg-blue-50 focus:outline-none focus:ring-4 focus:ring-blue-300">Erneut versuchen</a>
        </div>
    </div>
{% endblock %}
